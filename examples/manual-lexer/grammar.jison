%locations
%token NUMBER OPERATOR EOF

%left OPERATOR
%%

s: expr EOF { return $1; }
;

expr
  : expr OPERATOR expr
      {
        $$ = {
          type: "OPERATOR",
          lexeme: $2,
          left: $1,
          right: $3,
          loc: @2
        };
      }
  | NUMBER
      {
        $$ = {
          type: "number",
          value: Number($1),
          loc: @1
        };
      }
  ;

%%

/*
The parser variable is defined in the file generated by Jison at the point where this comment is placed.
And thus, when uncommented, the following lines will set the parser's lexer to the manually written lexer defined in manual-lexer.js.
*/
//const lexer = require("./manual-lexer.js");
//parser.lexer = lexer;