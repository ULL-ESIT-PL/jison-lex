{
  "source": {
    "include": [
      "index.js",
      "cli.js",
      "examples/more/lexer.js"
    ],
    "includePattern": ".+\\.js(doc|on)?$",
    "excludePattern": "(^|/)node_modules/|tests/"
  },
  "opts": {
    "destination": "./docs",
    "readme": "./README.md",
    "outputSourceFiles": true,
    "encoding": "utf8",
    "recurse": false,
    "private": false
  },
  "plugins": [
    "plugins/markdown"
  ]
}
