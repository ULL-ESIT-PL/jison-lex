{
  "source": {
    "include": [
      "index.js",
      "cli.js"
    ],
    "includePattern": ".+\\.js(doc|on)?$",
    "excludePattern": "(^|/)node_modules/|tests/"
  },
  "opts": {
    "destination": "./docs",
    "template": "node_modules/better-docs",
    "readme": "./README.md",
    "tutorials": "./examples",
    "outputSourceFiles": true,
    "encoding": "utf8",
    "recurse": false,
    "private": false
  },
  "docdash": {
    "search": true,
    "collapse": true
  },
  "plugins": [
    "plugins/markdown"
  ],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  }
}
