{
  "author": "Zach Carter <zach@carter.name> (http://zaa.ch)",
  "contributors": [
    "Casiano Rodríguez León <crguezl@ull.edu.es>"
  ],
  "name": "@ull-esit-pl/jison-lex",
  "description": "lexical analyzer generator used by jison",
  "version": "0.3.13",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "jison",
    "parser",
    "generator",
    "lexer",
    "flex",
    "tokenizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ULL-ESIT-PL/jison-lex.git"
  },
  "bugs": {
    "url": "https://github.com/ULL-ESIT-PL/jison-lex.git/issues"
  },
  "main": "index.js",
  "bin": {
    "jison-lex": "cli.js"
  },
  "engines": {
    "node": ">=0.4"
  },
  "dependencies": {
    "commander": "^11.0.3",
    "lex-parser": "0.1.x"
  },
  "devDependencies": {
    "@ull-esit-pl/jison": "github:ull-esit-pl/jison",
    "jsdoc": "^4.0.0",
    "test": "0.4.4"
  },
  "scripts": {
    "test": "node tests/all-tests.js",
    "pub": "source .env && npm publish",
    "grammar": "jison examples/grammar.jison -o examples/parser.js",
    "clean": "rm -f examples/example.js examples/parser.js",
    "docs": "jsdoc -c jsdoc.json",
    "docs:serve": "npx http-server ./docs -p 8080"
  },
  "directories": {
    "lib": "lib",
    "tests": "tests"
  },
  "homepage": "https://gerhobbelt.github.io/jison/docs/#lexical-analysis"
}
